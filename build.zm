# @deps builder
import @confy


#_______________________________________
# @section Dependencies
#_____________________________
# mdk
const mstd          = confy.dependency("mstd",    "https://codeberg.org/heysokam/mstd",        .())
const mglfw         = confy.dependency("mglfw",   "https://codeberg.org/heysokam/mglfw",       .())
const mgl           = confy.dependency("mgl",     "https://codeberg.org/heysokam/mgl",         .())
const cvulkan_c     = confy.dependency("cvk",     "https://codeberg.org/heysokam/cvulkan",     .())
const cvulkan       = confy.dependency("cvulkan", "https://codeberg.org/heysokam/cvulkan.ffi", (deps: &[cvulkan_c, mstd], src: "zig/src"))
const mmath         = confy.dependency("mmath",   "https://codeberg.org/heysokam/mmath",       (deps: &[mstd]))
const msys          = confy.dependency("msys",    "https://codeberg.org/heysokam/msys",        (deps: &[mstd,  mglfw]))
const minp          = confy.dependency("minp",    "https://codeberg.org/heysokam/minp",        (deps: &[mmath, msys]))
const mcam          = confy.dependency("mcam",    "https://codeberg.org/heysokam/mcam",        (deps: &[mstd,  mmath, minp]))
const zigimg_options = confy.dependency("enabled_formats", "https://codeberg.org/heysokam/mimg", (entry: "zigimg_options.zig"))
const zigimg        = confy.dependency("zigimg",  "https://github.com/zigimg/zigimg",          (src: ".", deps: &[zigimg_options]))
const mimg          = confy.dependency("mimg",    "https://codeberg.org/heysokam/mimg",        (deps: &[zigimg, mstd]))
from ./src/build/libs.zig import freetype
const mfont         = confy.dependency("mfont",   "https://codeberg.org/heysokam/mfont",       (deps: &[mstd, mmath, mimg, freetype.dependency]))
const mui           = confy.dependency("mui",     "https://codeberg.org/heysokam/mui",         (deps: &[mstd, mmath, mimg, mfont], entry: "zig/core.none.zig"))
# Renderer
const minirender    = confy.dependency("minirender",    "https://github.com/MechasNotBrains/minirender", (deps: &[mstd, mmath, mcam, mglfw, msys, minp, mimg, mfont, mui, cvulkan_c, cvulkan]))
const minirender_gl = confy.dependency("minirender_gl", "https://github.com/MechasNotBrains/minirender", (deps: &[mstd, mmath, mcam, mglfw, msys, minp, mgl, mui], entry: "minirender/core.gl.zig"))
const dependencies  = &[mstd, mmath, minp, mcam, mglfw, msys, mui, cvulkan_c, cvulkan, minirender, zigimg, zigimg_options, mimg, freetype.dependency, mfont]
const deps_gl       = &[mstd, mmath, minp, mcam, mglfw, msys, mgl, mui, zigimg, zigimg_options, mimg, freetype.dependency, mfont, minirender_gl]
const flags         = &["-lc", "-lglfw", "-lvulkan"]
const flags_gl      = &["-lc", "-lglfw", "-lGL"]


#_______________________________________
# @section Builder: Entry Point
#_____________________________
proc main (P :confy.Process): !void=
  # Setup the samples config
  var cfg      = confy.Config.default()
  cfg.dir.src  = "samples"
  cfg.verbose  = true
  let cvulkan_src = try cvulkan.path_src(cfg, .())
  let cvulkan_ffi = try confy.path.join(P.arena.allocator(), &[cvulkan_src.data(), "cvulkan/cvulkan.ffi.c"])
  let cvk_src     = try cvulkan_c.path_src(cfg, .())
  #___________________
  # Build the OpenGL sample
  var gl = try confy.Program("opengl.zig", (P:P, cfg: cfg, deps: deps_gl, flags: flags_gl))
  try gl.build()
  # try gl.run()
  # Build the WIP sample
  var wip = try confy.Program("wip.zig", (P:P, cfg: cfg, deps: dependencies, flags: flags))
  try wip.src.files.add_one(cvulkan_ffi)
  let freetype_dir = try freetype.download(P, cfg, .host(), ".")
  try wip.flags.add_many(&["-I", cvk_src.data(), "-L", freetype_dir, "-lfreetype"])
  try wip.build()
  try wip.run()

